    {
      "name": "3. Hospedagem - criar reserva e hospedagem",
      "description": "Reserva NÃO usa acomodação (status RESERVADA, valor total 0). Hospedagem exige a acomodação em unidadeLocacao.id (status HOSPEDADA, valor total = dias x diária). Basta informar os códigos: nome do hóspede e legenda/número/diária da unidade são preenchidos pela API.",
      "item": [
        {
          "name": "Criar reserva (sem acomodação)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Valor total zerado\", function () { pm.expect(pm.response.json().valorTotal).to.eql(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hospedagens/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hospedagens",
                "reservas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hospede\": {\n    \"id\": {{cadastroId}}\n  },\n  \"duracao\": {\n    \"dataInicial\": \"2026-10-01\",\n    \"dataFinal\": \"2026-10-04\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Criar hospedagem (com acomodação)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Valor total calculado\", function () { pm.expect(pm.response.json().valorTotal).to.be.above(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
