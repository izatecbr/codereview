              "raw": "{\n  \"nome\": \"Maria da Silva\",\n  \"cpfCnpj\": \"123.456.789-00\",\n  \"documento\": \"RG 1234567\",\n  \"aniversario\": \"1990-05-15\",\n  \"email\": \"maria@email.com\",\n  \"endereco\": {\n    \"logradouro\": \"Rua das Flores\",\n    \"numero\": \"123\",\n    \"complemento\": \"Apto 101\",\n    \"bairro\": \"Centro\",\n    \"cidade\": \"São Paulo\",\n    \"uf\": \"SP\",\n    \"cep\": 12345678,\n    \"ibge\": 3550308\n  },\n  \"celular\": {\n    \"numero\": 11987654321,\n    \"whatsapp\": true\n  }\n}",
